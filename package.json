{
  "name": "sshxl-autoapply",
  "version": "2.0.0",
  "private": true,
  "description": "Violentmonkey userscript: daily quota-driven auto-apply for sshxl.nl rental listings",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:watch": "vite build --watch",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node tests/browser/serve.cjs",
    "smoke:drive": "node tests/browser/drive.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.8.0",
    "taze": "^21.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-monkey": "^8.1.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@preact/signals": "^2.11.1",
    "preact": "^10.29.8"
  }
